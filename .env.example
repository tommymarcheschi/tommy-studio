VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Watercolor Studio ─────────────────────────────────────────────────────────
# All OPTIONAL. The generator works fully with none of these set (classical
# in-browser engine). Add them to unlock upgrades, in roughly this order:

# (1) AI repaint pass — likeness-preserving img2img. Pick ONE provider.
#     Replicate (recommended): also set REPLICATE_MODEL to your img2img model.
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=stability-ai/sdxl:<version-hash>
#     or OpenAI gpt-image-1:
# OPENAI_API_KEY=

# (2) Order handling — store the print-ready file + email yourself each order.
# SUPABASE_SERVICE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# RESEND_API_KEY=
# ORDER_NOTIFY_EMAIL=tommymarcheschi@gmail.com

# (3) Payment — your PERSONAL Stripe (separate from BMAG / BTC Inc).
#     Drops into src/routes/watercolor/api/order/+server.ts (see TODO there).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_STRIPE_PUBLISHABLE_KEY=
